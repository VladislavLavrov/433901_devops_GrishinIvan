pipeline {
    agent any
    stages {
        stage('Hello') {
            steps {
                echo 'Hello jenkins'
            }
        }
        stage('Build Docker Image') {
            steps {
                // Переходим в папку, где лежит docker-compose.yml
                sh 'cd App_practical/3_Calculator && ls -l'
                sh 'cd App_practical/3_Calculator && docker compose build'
            }
        }
        stage('Start Docker Container') {
            steps {
                // Тоже переходим в нужную папку для запуска
                sh 'cd App_practical/3_Calculator && docker compose up -d'
            }
        }
    }
}