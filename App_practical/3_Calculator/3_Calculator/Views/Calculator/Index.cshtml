@model List<Calculator.Data.DataInputVariant>
@{
    ViewData["Title"] = "Калькулятор";
}

<h2>Калькулятор</h2>

<form asp-action="Calculate" asp-controller="Calculator" method="post">
    @Html.AntiForgeryToken()

    <div style="margin-bottom: 8px;">
        <label>Первое число:</label>
        <input type="number" step="any" name="num1" required />
    </div>

    <div style="margin-bottom: 8px;">
        <label>Второе число:</label>
        <input type="number" step="any" name="num2" required />
    </div>

    <div style="margin-bottom: 8px;">
        <label>Операция:</label>
        <select name="operation">
            <option value="1">Сложение (+)</option>
            <option value="2">Вычитание (−)</option>
            <option value="3">Умножение (×)</option>
            <option value="4">Деление (÷)</option>
        </select>
    </div>

    <button type="submit" style="margin-top: 10px;">Вычислить</button>
</form>

<hr style="margin-top: 30px;" />

<h3>История операций</h3>

@if (Model == null || Model.Count == 0)
{
    <p>Пока операций нет.</p>
}
else
{
    <table border="1" cellpadding="8" cellspacing="0" style="border-collapse: collapse; width: 100%;">
        <thead>
            <tr>
                <th>ID</th>
                <th>Операнд 1</th>
                <th>Операнд 2</th>
                <th>Операция</th>
                <th>Результат</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ID_DataInputVariant</td>
                    <td>@item.Operand_1</td>
                    <td>@item.Operand_2</td>
                    <td>@item.Type_operation</td>
                    <td>@item.Result</td>
                </tr>
            }
        </tbody>
    </table>
}